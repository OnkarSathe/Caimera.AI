NODE_ENV=production
PORT=4000

# Local dev only (Heroku uses DATABASE_URL / REDIS_URL automatically)
DB_HOST=localhost
DB_PORT=5432
DB_USER=caimera
DB_PASSWORD=your_password
DB_NAME=caimera_db

REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Game tuning
QUESTION_TIMEOUT_MS=45000
NEXT_QUESTION_DELAY_MS=3000

# CORS (set to your frontend URL in production)
CORS_ORIGIN=https://your-app.herokuapp.com
